{% style %}
  {% # Loads all font variantions with display: swap %}
  {{ settings.type_primary_font | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}

  :root {
    /* Typography + layout */
    --font-primary--family: {{ settings.type_primary_font.family }}, {{ settings.type_primary_font.fallback_families }};
    --font-primary--style: {{ settings.type_primary_font.style }};
    --font-primary--weight: {{ settings.type_primary_font.weight }};
    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;

    /* Shopify legacy tokens (used by critical.css) */
    --color-background: {{ settings.background_color | default: '#FFFFFF' }};
    --color-foreground: {{ settings.foreground_color | default: '#333333' }};
    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;

    /* ── shadcn/ui-style design tokens ─────────────────────
       Utilities like bg-background, text-primary, border-border
       resolve through these CSS variables at runtime, so the
       whole theme can be recolored from the theme editor. */

    /* Radius */
    --radius: {{ settings.radius | default: 0.625 }}rem;

    /* Base surfaces */
    --background: {{ settings.background_color | default: 'oklch(1 0 0)' }};
    --foreground: {{ settings.foreground_color | default: 'oklch(0.145 0 0)' }};
    --card: {{ settings.card_color | default: 'oklch(1 0 0)' }};
    --card-foreground: {{ settings.foreground_color | default: 'oklch(0.145 0 0)' }};
    --popover: {{ settings.card_color | default: 'oklch(1 0 0)' }};
    --popover-foreground: {{ settings.foreground_color | default: 'oklch(0.145 0 0)' }};

    /* Brand / actions */
    --primary: {{ settings.primary_color | default: 'oklch(0.205 0 0)' }};
    --primary-foreground: {{ settings.primary_foreground_color | default: 'oklch(0.985 0 0)' }};
    --secondary: {{ settings.secondary_color | default: 'oklch(0.97 0 0)' }};
    --secondary-foreground: {{ settings.secondary_foreground_color | default: 'oklch(0.205 0 0)' }};

    /* Muted / accent */
    --muted: {{ settings.muted_color | default: 'oklch(0.97 0 0)' }};
    --muted-foreground: {{ settings.muted_foreground_color | default: 'oklch(0.556 0 0)' }};
    --accent: {{ settings.accent_color | default: 'oklch(0.97 0 0)' }};
    --accent-foreground: {{ settings.accent_foreground_color | default: 'oklch(0.205 0 0)' }};

    /* Feedback / borders */
    --destructive: {{ settings.destructive_color | default: 'oklch(0.577 0.245 27.325)' }};
    --border: {{ settings.border_color | default: 'oklch(0.922 0 0)' }};
    --input: {{ settings.input_color | default: 'oklch(0.922 0 0)' }};
    --ring: {{ settings.ring_color | default: 'oklch(0.708 0 0)' }};
  }

  /* Dark mode — toggle by adding the .dark class to <html>.
     Wire a theme setting or a manual class switch to activate. */
  .dark {
    --background: oklch(0.145 0 0);
    --foreground: oklch(0.985 0 0);
    --card: oklch(0.205 0 0);
    --card-foreground: oklch(0.985 0 0);
    --popover: oklch(0.205 0 0);
    --popover-foreground: oklch(0.985 0 0);
    --primary: oklch(0.922 0 0);
    --primary-foreground: oklch(0.205 0 0);
    --secondary: oklch(0.269 0 0);
    --secondary-foreground: oklch(0.985 0 0);
    --muted: oklch(0.269 0 0);
    --muted-foreground: oklch(0.708 0 0);
    --accent: oklch(0.269 0 0);
    --accent-foreground: oklch(0.985 0 0);
    --destructive: oklch(0.704 0.191 22.216);
    --border: oklch(1 0 0 / 10%);
    --input: oklch(1 0 0 / 15%);
    --ring: oklch(0.556 0 0);
  }
{% endstyle %}
