{% comment %}
  LiqKit: showcase section — a shadcn/ui-style landing page for the component library.
  Add this section to any page to demo every LiqKit component with the token system.
{% endcomment %}

<div class="bg-background text-foreground">
  <div class="mx-auto max-w-6xl px-6 py-20">

    {% comment %} ── Announcement pill ── {% endcomment %}
    <div class="mb-8 flex justify-center">
      <span class="inline-flex items-center gap-2 rounded-full border border-border bg-muted px-3 py-1 text-xs text-muted-foreground">
        <span class="h-1.5 w-1.5 rounded-full bg-primary"></span>
        LiqKit v0.3 — copy-paste Liquid + Tailwind
      </span>
    </div>

    {% comment %} ── Hero ── {% endcomment %}
    <div class="text-center">
      <h1 class="mx-auto max-w-3xl text-4xl font-bold tracking-tight text-foreground sm:text-6xl">
        Build your component library.
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-muted-foreground">
        Beautifully designed Liquid components that you copy-paste into your Shopify
        theme. Accessible. Customizable. Open Source. Powered by CSS design tokens.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        {% render 'liqkit-button', text: 'Get started', url: '#components', variant: 'primary' %}
        {% render 'liqkit-button', text: 'View on GitHub', url: 'https://github.com/mehrabix/liqkit', variant: 'outline' %}
      </div>
      <p class="mt-4 text-xs text-muted-foreground">
        Copy-paste with {% raw %}{% render 'liqkit-button' %}{% endraw %} — no runtime, no framework, no build step for merchants.
      </p>
    </div>

    {% comment %} ── Terminal card ── {% endcomment %}
    <div class="mx-auto mt-12 max-w-2xl">
      <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
        <div class="flex items-center gap-1.5 border-b border-border px-4 py-2.5">
          <span class="h-2.5 w-2.5 rounded-full bg-destructive/60"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-accent-foreground/30"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-muted-foreground/40"></span>
          <span class="ml-3 font-mono text-xs text-muted-foreground">terminal</span>
        </div>
        <div class="p-4 font-mono text-sm leading-relaxed">
          <p class="text-muted-foreground">$ npx create-kite my-theme --components</p>
          <p class="text-foreground">✓ Template copied (components)</p>
          <p class="text-foreground">✓ Tailwind CSS v4 wired (design tokens)</p>
          <p class="text-foreground">✓ LiqKit components installed (7 snippets)</p>
          <p class="text-muted-foreground">$ pnpm dev</p>
        </div>
      </div>
    </div>

    {% comment %} ── Component preview grid ── {% endcomment %}
    <div id="components" class="mt-20">
      <h2 class="text-center text-2xl font-semibold text-foreground sm:text-3xl">
        The components
      </h2>
      <p class="mx-auto mt-2 max-w-xl text-center text-muted-foreground">
        Every component is styled entirely with CSS tokens — recolor the whole theme
        from the theme editor without touching code.
      </p>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">

        {% comment %} Buttons {% endcomment %}
        <div class="flex flex-col rounded-lg border border-border bg-card p-6">
          <h3 class="text-sm font-medium text-card-foreground">Buttons</h3>
          <div class="mt-4 flex flex-col items-start gap-3">
            {% render 'liqkit-button', text: 'Primary', url: '#' %}
            {% render 'liqkit-button', text: 'Secondary', url: '#', variant: 'secondary' %}
            {% render 'liqkit-button', text: 'Outline', url: '#', variant: 'outline' %}
          </div>
        </div>

        {% comment %} Badges {% endcomment %}
        <div class="flex flex-col rounded-lg border border-border bg-card p-6">
          <h3 class="text-sm font-medium text-card-foreground">Badges</h3>
          <div class="mt-4 flex flex-wrap items-center gap-2">
            {% render 'liqkit-badge', text: 'Default', tone: 'neutral' %}
            {% render 'liqkit-badge', text: 'New', tone: 'green' %}
            {% render 'liqkit-badge', text: 'Sale', tone: 'red' %}
            {% render 'liqkit-badge', text: 'Info', tone: 'blue' %}
          </div>
        </div>

        {% comment %} Cards {% endcomment %}
        <div class="flex flex-col rounded-lg border border-border bg-card p-6">
          <h3 class="text-sm font-medium text-card-foreground">Cards</h3>
          <div class="mt-4">
            {% render 'liqkit-card', title: 'Card title', body: 'A reusable card component using bg-card, border-border and text-muted-foreground tokens.' %}
          </div>
        </div>

        {% comment %} Accordion {% endcomment %}
        <div class="flex flex-col rounded-lg border border-border bg-card p-6">
          <h3 class="text-sm font-medium text-card-foreground">Accordion</h3>
          <div class="mt-4 space-y-2">
            {% render 'liqkit-accordion', title: 'Is it accessible?', body: 'Yes — native details/summary, keyboard-friendly, no JS required.' %}
            {% render 'liqkit-accordion', title: 'Does it use tokens?', body: 'Yes — every color and radius resolves from CSS variables.' %}
          </div>
        </div>

        {% comment %} Modal {% endcomment %}
        <div class="flex flex-col rounded-lg border border-border bg-card p-6">
          <h3 class="text-sm font-medium text-card-foreground">Modal</h3>
          <div class="mt-4 flex items-center gap-3">
            <button
              type="button"
              class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition hover:bg-primary/90"
              onclick="document.getElementById('showcase-modal').showModal()"
            >
              Open modal
            </button>
            <p class="text-xs text-muted-foreground">Native &lt;dialog&gt;</p>
          </div>
          {% render 'liqkit-modal', id: 'showcase-modal', title: 'LiqKit modal', body: 'A dialog built with the native HTML element — zero JavaScript required, fully token-styled.' %}
        </div>

        {% comment %} Price {% endcomment %}
        <div class="flex flex-col rounded-lg border border-border bg-card p-6">
          <h3 class="text-sm font-medium text-card-foreground">Price</h3>
          <div class="mt-4 flex flex-col items-start gap-3">
            <div class="flex items-baseline gap-2">
              <span class="text-base font-semibold text-foreground">$120.00</span>
            </div>
            <div class="flex items-baseline gap-2">
              <span class="text-base font-semibold text-foreground">$90.00</span>
              <s class="text-sm text-muted-foreground">$120.00</s>
              <span class="rounded bg-destructive/10 px-1.5 py-0.5 text-xs font-medium text-destructive">25% off</span>
            </div>
          </div>
        </div>

      </div>
    </div>

    {% comment %} ── Dark mode demo (shows .dark tokens) ── {% endcomment %}
    <div class="dark mt-20 overflow-hidden rounded-xl border border-border bg-background text-foreground">
      <div class="flex items-center justify-between border-b border-border px-6 py-4">
        <h2 class="text-lg font-semibold">Dark mode</h2>
        <span class="rounded-full bg-muted px-2.5 py-0.5 text-xs text-muted-foreground">.dark tokens</span>
      </div>
      <div class="grid gap-6 p-6 sm:grid-cols-2 lg:grid-cols-3">
        {% render 'liqkit-button', text: 'Primary', url: '#' %}
        {% render 'liqkit-button', text: 'Outline', url: '#', variant: 'outline' %}
        {% render 'liqkit-badge', text: 'Sale', tone: 'red' %}
        {% render 'liqkit-card', title: 'Dark card', body: 'Same component, different tokens — the .dark class on this container does all the work.' %}
        {% render 'liqkit-accordion', title: 'Tokens in dark mode', body: 'The CSS variables swap via .dark and every utility follows automatically.' %}
      </div>
    </div>

    {% comment %} ── Footer CTA ── {% endcomment %}
    <div class="mt-20 text-center">
      <h2 class="text-2xl font-semibold text-foreground sm:text-3xl">Own your components.</h2>
      <p class="mx-auto mt-2 max-w-xl text-muted-foreground">
        Copy them into your theme, style them your way. No vendor lock-in —
        everything is plain Liquid and CSS.
      </p>
      <div class="mt-6 flex justify-center">
        {% render 'liqkit-button', text: 'Copy the library', url: 'https://github.com/mehrabix/liqkit', variant: 'primary' %}
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "LiqKit Showcase",
  "tag": "section",
  "class": "liqkit-showcase",
  "settings": [],
  "presets": [
    {
      "name": "LiqKit Showcase",
      "category": "LiqKit"
    }
  ]
}
{% endschema %}
