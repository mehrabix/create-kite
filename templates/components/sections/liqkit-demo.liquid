{% comment %}
  LiqKit: demo section showcasing available components.
{% endcomment %}
<div class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-6 py-16 text-center">
  <h2 class="text-3xl font-bold">LiqKit Components</h2>
  <p class="max-w-xl text-[#5c5f62]">
    Copy-paste Liquid + Tailwind components for Shopify themes. This demo section
    shows the bundled snippets.
  </p>
  <div class="flex flex-wrap items-center justify-center gap-4">
    {% render 'liqkit-button', text: 'Primary action', url: '/collections/all' %}
    {% render 'liqkit-button', text: 'Secondary action', url: '/pages/about' %}
  </div>
</div>

{% schema %}
{
  "name": "LiqKit Demo",
  "tag": "section",
  "class": "liqkit-demo",
  "settings": [],
  "presets": [
    {
      "name": "LiqKit Demo",
      "category": "LiqKit"
    }
  ]
}
{% endschema %}
