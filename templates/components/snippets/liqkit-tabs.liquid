{% comment %}
  LiqKit: tabs component snippet — shadcn-compatible, JS-driven.
  Usage: {% render 'liqkit-tabs', id: 'my-tabs', tabs: 'Account|Password', panels: 'Account panel content|Password panel content' %}
  Requires liqkit.js. Arrow-key navigation included.
{% endcomment %}
<div
  data-liqkit-tabs
  data-slot="tabs"
  class="w-full"
>
  <div
    data-slot="tabs-list"
    class="inline-flex h-9 items-center justify-center rounded-lg bg-muted p-1 text-muted-foreground"
  >
    {%- assign tab_list = tabs | default: 'Tab one|Tab two' | split: '|' -%}
    {%- for tab in tab_list -%}
      <button
        type="button"
        data-liqkit-tab-trigger="{{ id }}-panel-{{ forloop.index0 }}"
        data-state="{% if forloop.first %}active{% else %}inactive{% endif %}"
        data-slot="tabs-trigger"
        role="tab"
        aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
        tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
        class="inline-flex items-center justify-center gap-1.5 rounded-md px-3 py-1 text-sm font-medium whitespace-nowrap transition-all outline-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 data-[state=active]:bg-background data-[state=active]:text-foreground data-[state=active]:shadow-xs"
      >
        {{ tab }}
      </button>
    {%- endfor -%}
  </div>
  {%- assign panel_list = panels | default: 'Panel one content|Panel two content' | split: '|' -%}
  {%- for panel in panel_list -%}
    <div
      id="{{ id }}-panel-{{ forloop.index0 }}"
      data-liqkit-tab-panel
      data-slot="tabs-content"
      role="tabpanel"
      data-state="{% if forloop.first %}active{% else %}inactive{% endif %}"
      {% unless forloop.first %}hidden{% endunless %}
      class="mt-4 text-sm leading-relaxed text-muted-foreground"
    >
      {{ panel }}
    </div>
  {%- endfor -%}
</div>
