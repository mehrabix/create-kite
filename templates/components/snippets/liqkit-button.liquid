{% comment %}
  LiqKit: button component snippet (shadcn-compatible).
  Usage: {% render 'liqkit-button', text: 'Shop now', url: '/collections/all', variant: 'default', size: 'default' %}
  Variants: default, destructive, outline, secondary, ghost, link
  Sizes: default, xs, sm, lg, icon
{% endcomment %}
{%- case variant -%}
  {%- when 'destructive' -%}
    {%- assign v = 'bg-destructive text-white hover:bg-destructive/90 focus-visible:ring-destructive/20 dark:bg-destructive/60 dark:focus-visible:ring-destructive/40' -%}
  {%- when 'outline' -%}
    {%- assign v = 'border bg-background shadow-xs hover:bg-accent hover:text-accent-foreground dark:border-input dark:bg-input/30 dark:hover:bg-input/50' -%}
  {%- when 'secondary' -%}
    {%- assign v = 'bg-secondary text-secondary-foreground hover:bg-secondary/80' -%}
  {%- when 'ghost' -%}
    {%- assign v = 'hover:bg-accent hover:text-accent-foreground dark:hover:bg-accent/50' -%}
  {%- when 'link' -%}
    {%- assign v = 'text-primary underline-offset-4 hover:underline' -%}
  {%- else -%}
    {%- assign v = 'bg-primary text-primary-foreground hover:bg-primary/90' -%}
{%- endcase -%}
{%- case size -%}
  {%- when 'xs' -%}
    {%- assign s = 'h-6 gap-1 rounded-md px-2 text-xs' -%}
  {%- when 'sm' -%}
    {%- assign s = 'h-8 gap-1.5 rounded-md px-3' -%}
  {%- when 'lg' -%}
    {%- assign s = 'h-10 rounded-md px-6' -%}
  {%- when 'icon' -%}
    {%- assign s = 'size-9' -%}
  {%- else -%}
    {%- assign s = 'h-9 px-4 py-2' -%}
{%- endcase -%}
<a
  href="{{ url | default: '#' }}"
  data-slot="button"
  data-variant="{{ variant | default: 'default' }}"
  class="inline-flex shrink-0 items-center justify-center gap-2 rounded-md text-sm font-medium whitespace-nowrap transition-all outline-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50 no-underline {{ v }} {{ s }}"
>
  {{ text | default: 'Button' }}
</a>
