{% comment %}
  LiqKit: card component snippet (shadcn-compatible).
  Usage: {% render 'liqkit-card', title: 'Card title', description: 'Card description', body: 'Body text' %}
{% endcomment %}
<div data-slot="card" class="flex flex-col gap-6 rounded-xl border bg-card py-6 text-card-foreground shadow-sm">
  <div data-slot="card-header" class="grid auto-rows-min grid-rows-[auto_auto] items-start gap-2 px-6">
    {% if title %}
      <div data-slot="card-title" class="leading-none font-semibold">{{ title }}</div>
    {% endif %}
    {% if description %}
      <div data-slot="card-description" class="text-sm text-muted-foreground">{{ description }}</div>
    {% endif %}
  </div>
  {% if body %}
    <div data-slot="card-content" class="px-6">
      <div class="text-sm leading-relaxed text-muted-foreground">{{ body }}</div>
    </div>
  {% endif %}
  {% if footer %}
    <div data-slot="card-footer" class="flex items-center px-6">{{ footer }}</div>
  {% endif %}
</div>
