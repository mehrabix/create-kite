{% comment %}
  LiqKit: card component snippet.
  Usage: {% render 'liqkit-card', title: 'Card title', body: 'Card body text' %}
{% endcomment %}
<div class="flex flex-col rounded-lg border border-border bg-card text-card-foreground p-6 shadow-sm">
  {% if title %}
    <h3 class="text-lg font-semibold">{{ title }}</h3>
  {% endif %}
  {% if body %}
    <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{{ body }}</p>
  {% endif %}
  {% if footer %}
    <div class="mt-4 border-t border-border pt-4">{{ footer }}</div>
  {% endif %}
</div>
