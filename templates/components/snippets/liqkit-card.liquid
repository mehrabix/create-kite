{% comment %}
  LiqKit: card component snippet.
  Usage: {% render 'liqkit-card', title: 'Card title', body: 'Card body text' %}
{% endcomment %}
<div class="flex flex-col rounded-lg border border-neutral-200 bg-white p-6 shadow-sm">
  {% if title %}
    <h3 class="text-lg font-semibold text-neutral-900">{{ title }}</h3>
  {% endif %}
  {% if body %}
    <p class="mt-2 text-sm leading-relaxed text-neutral-600">{{ body }}</p>
  {% endif %}
  {% if footer %}
    <div class="mt-4 pt-4 border-t border-neutral-100">{{ footer }}</div>
  {% endif %}
</div>
