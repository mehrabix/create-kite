{% comment %}
  LiqKit: badge component snippet.
  Usage: {% render 'liqkit-badge', text: 'Sale', tone: 'red' %}
  Tones: red, green, blue, neutral (custom map below)
{% endcomment %}
{%- assign tone_map = 'red:bg-destructive/10 text-destructive|green:bg-primary/10 text-primary|blue:bg-accent text-accent-foreground|neutral:bg-muted text-muted-foreground' -%}
{%- assign tone_classes = tone_map | split: '|' | where: 'contains', tone | first | split: ':' | last | default: 'bg-muted text-muted-foreground' -%}
<span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium {{ tone_classes }}">
  {{ text }}
</span>
