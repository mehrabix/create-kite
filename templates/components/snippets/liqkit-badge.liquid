{% comment %}
  LiqKit: badge component snippet.
  Usage: {% render 'liqkit-badge', text: 'Sale', tone: 'red' %}
  Tones: red, green, blue, neutral
{% endcomment %}
{%- assign tone_map = 'red:bg-red-100 text-red-700|green:bg-green-100 text-green-700|blue:bg-blue-100 text-blue-700|neutral:bg-neutral-100 text-neutral-700' -%}
{%- assign tone_classes = tone_map | split: '|' | where: 'contains', tone | first | split: ':' | last | default: 'bg-neutral-100 text-neutral-700' -%}
<span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium {{ tone_classes }}">
  {{ text }}
</span>
