{% comment %}
  LiqKit: switch component snippet — shadcn-compatible, JS-driven.
  Usage: {% render 'liqkit-switch', id: 'my-switch', checked: true, label: 'Enable alerts' %}
  Requires liqkit.js. Toggle with data-state animation like shadcn.
{% endcomment %}
{%- assign is_checked = checked | default: false -%}
<label class="inline-flex items-center gap-3">
  <button
    type="button"
    role="switch"
    data-liqkit-switch
    data-state="{% if is_checked %}checked{% else %}unchecked{% endif %}"
    aria-checked="{% if is_checked %}true{% else %}false{% endif %}"
    data-slot="switch"
    class="peer inline-flex shrink-0 items-center rounded-full border border-transparent shadow-xs transition-all outline-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 h-[1.15rem] w-8 data-[state=checked]:bg-primary data-[state=unchecked]:bg-input dark:data-[state=unchecked]:bg-input/80"
  >
    <span
      data-slot="switch-thumb"
      class="pointer-events-none block rounded-full bg-background ring-0 transition-transform size-4 data-[state=checked]:translate-x-[calc(100%-2px)] data-[state=unchecked]:translate-x-0 dark:data-[state=checked]:bg-primary-foreground dark:data-[state=unchecked]:bg-foreground"
    ></span>
  </button>
  {% if label %}
    <span class="text-sm font-medium leading-none">{{ label }}</span>
  {% endif %}
</label>
