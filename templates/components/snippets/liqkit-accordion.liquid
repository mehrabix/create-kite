{% comment %}
  LiqKit: accordion component snippet (no JS needed).
  Usage: {% render 'liqkit-accordion', title: 'Question', body: 'Answer' %}
{% endcomment %}
<details class="group rounded-lg border border-border bg-card">
  <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-3 text-sm font-medium text-card-foreground [&::-webkit-details-marker]:hidden">
    {{ title }}
    <span class="text-muted-foreground transition-transform group-open:rotate-45">+</span>
  </summary>
  <div class="border-t border-border px-4 py-3 text-sm leading-relaxed text-muted-foreground">
    {{ body }}
  </div>
</details>
