{% comment %}
  LiqKit: accordion component snippet (JS-driven, shadcn-compatible).
  Usage: {% render 'liqkit-accordion', title: 'Question', body: 'Answer', open: false %}
  Requires liqkit.js. Single-open behavior with height animation like shadcn.
{% endcomment %}
{%- assign is_open = open | default: false -%}
<div
  data-liqkit-accordion
  data-slot="accordion"
  class="w-full"
>
  <div
    data-liqkit-accordion-item
    data-state="{% if is_open %}open{% else %}closed{% endif %}"
    data-slot="accordion-item"
    class="border-b last:border-b-0"
  >
    <h3 class="flex">
      <button
        type="button"
        data-liqkit-accordion-trigger
        data-slot="accordion-trigger"
        aria-expanded="{% if is_open %}true{% else %}false{% endif %}"
        class="flex flex-1 items-start justify-between gap-4 rounded-md py-4 text-left text-sm font-medium transition-all outline-none hover:underline focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 [&[data-state=open]>svg]:rotate-180"
      >
        {{ title }}
        <svg
          class="pointer-events-none size-4 shrink-0 translate-y-0.5 text-muted-foreground transition-transform duration-200"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m6 9 6 6 6-6" />
        </svg>
      </button>
    </h3>
    <div
      data-liqkit-accordion-content
      data-slot="accordion-content"
      aria-hidden="{% if is_open %}false{% else %}true{% endif %}"
      class="text-sm"
    >
      <div class="pt-0 pb-4">{{ body }}</div>
    </div>
  </div>
</div>
