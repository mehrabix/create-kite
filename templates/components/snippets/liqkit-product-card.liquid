{% comment %}
  LiqKit: product-card component snippet.
  Usage: {% render 'liqkit-product-card', product: product %}
  Requires a product object. Links to the product page.
{% endcomment %}
{%- if product -%}
  <a href="{{ product.url }}" class="group flex flex-col overflow-hidden rounded-lg border border-border bg-card transition hover:shadow-md">
    <div class="aspect-square overflow-hidden bg-muted">
      {%- if product.featured_image -%}
        {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'h-full w-full object-cover transition group-hover:scale-105' }}
      {%- else -%}
        <div class="flex h-full w-full items-center justify-center text-muted-foreground">No image</div>
      {%- endif -%}
    </div>
    <div class="flex flex-1 flex-col gap-2 p-4">
      <h3 class="text-sm font-medium text-card-foreground">{{ product.title }}</h3>
      {% render 'liqkit-price', product: product %}
      <button
        type="button"
        class="mt-auto inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition hover:bg-primary/90"
      >
        Add to cart
      </button>
    </div>
  </a>
{%- else -%}
  <div class="rounded-lg border border-dashed border-border p-6 text-sm text-muted-foreground">
    Pass a product: {% raw %}{% render 'liqkit-product-card', product: product %}{% endraw %}
  </div>
{%- endif -%}
